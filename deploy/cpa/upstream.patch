+type bridgeFakeOAuth struct {
+	calls int
+	email string
+	fail  bool
+}
+
+func (f *bridgeFakeOAuth) GenerateAuthURL(state string, p *codex.PKCECodes) (string, error) {
+	return "https://example.invalid?state=" + state, nil
+}
+func (f *bridgeFakeOAuth) ExchangeCodeForTokens(context.Context, string, *codex.PKCECodes) (*codex.CodexAuthBundle, error) {
+	f.calls++
+	if f.fail {
+		return nil, errors.New("synthetic provider error")
+	}
+	return &codex.CodexAuthBundle{TokenData: codex.CodexTokenData{Email: f.email, AccessToken: "synthetic-access", RefreshToken: "synthetic-refresh", AccountID: "synthetic-account"}}, nil
+}
+func (f *bridgeFakeOAuth) CreateTokenStorage(b *codex.CodexAuthBundle) *codex.CodexTokenStorage {
+	return codex.NewCodexAuthWithProxyURL(nil, "direct").CreateTokenStorage(b)
+}
+func bridgeFixture(t *testing.T) (*Handler, *gin.Engine, *bridgeFakeOAuth, string) {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	dir := t.TempDir()
+	f := &bridgeFakeOAuth{email: "fixture@example.invalid"}
+	h := &Handler{cfg: &config.Config{AuthDir: dir}, tokenStore: sdkAuth.NewFileTokenStore()}
+	h.bridgeOAuthFactory = func(_ *config.Config, proxy string) codexOAuthService {
+		if proxy != "direct" {
+			t.Errorf("route inherited: %q", proxy)
+		}
+		return f
+	}
+	r := gin.New()
+	r.PUT("/sessions/:session_id", h.BridgeOAuthSession)
+	r.GET("/sessions/:session_id", h.BridgeOAuthSession)
+	r.DELETE("/sessions/:session_id", h.BridgeOAuthSession)
+	r.POST("/sessions/:session_id/callback", h.BridgeOAuthSession)
+	r.POST("/sessions/:session_id/commit", h.BridgeOAuthSession)
+	return h, r, f, dir
+}
+func bridgeRequest(t *testing.T, r *gin.Engine, method, path, body string, status int) map[string]any {
+	t.Helper()
+	w := httptest.NewRecorder()
+	req := httptest.NewRequest(method, path, strings.NewReader(body))
+	req.Header.Set("Content-Type", "application/json")
+	r.ServeHTTP(w, req)
+	if w.Code != status {
+		t.Fatalf("%s %s: status %d body %s", method, path, w.Code, w.Body.String())
+	}
+	var result map[string]any
+	if err := json.Unmarshal(w.Body.Bytes(), &result); err != nil {
+		t.Fatal(err)
+	}
+	return result
+}
+
+const bridgeTestPath = "/sessions/synthetic-session-0001"
+const bridgeTestStart = `{"identity":"fixture@example.invalid","route":{"type":"direct"}}`
+
+func bridgeStage(t *testing.T, r *gin.Engine) map[string]any {
+	t.Helper()
+	start := bridgeRequest(t, r, "PUT", bridgeTestPath, bridgeTestStart, 200)
+	callback := "http://localhost:1455/auth/callback?code=synthetic-code&state=" + url.QueryEscape(start["provider_state"].(string))
+	body, _ := json.Marshal(map[string]string{"redirect_url": callback})
+	return bridgeRequest(t, r, "POST", bridgeTestPath+"/callback", string(body), 200)
+}
+func TestBridgeOAuthStageCommitAndRotation(t *testing.T) {
+	h, r, f, dir := bridgeFixture(t)
+	stage := bridgeStage(t, r)
+	if stage["state"] != "staged" || f.calls != 1 {
+		t.Fatal(stage)
+	}
+	remote := stage["remote_id"].(string)
+	if _, err := os.Stat(filepath.Join(dir, remote)); !os.IsNotExist(err) {
+		t.Fatal("staged credential activated")
+	}
+	restarted := &Handler{cfg: h.cfg, tokenStore: sdkAuth.NewFileTokenStore()}
+	h = restarted
+	r = gin.New()
+	r.GET("/sessions/:session_id", h.BridgeOAuthSession)
+	r.POST("/sessions/:session_id/commit", h.BridgeOAuthSession)
+	completed := bridgeRequest(t, r, "POST", bridgeTestPath+"/commit", "{}", 200)
+	record := completed["record"].(map[string]any)
+	if completed["state"] != "completed" || record["credential_digest"] != stage["credential_digest"] {
+		t.Fatal(completed)
+	}
+	data, err := bridgeRead(filepath.Join(dir, remote))
+	if err != nil {
+		t.Fatal(err)
+	}
+	data["refresh_token"] = "synthetic-rotated"
+	if err = bridgeWrite(filepath.Join(dir, remote), data); err != nil {
+		t.Fatal(err)
+	}
+	again := bridgeRequest(t, r, "POST", bridgeTestPath+"/commit", "{}", 200)
+	if again["record"].(map[string]any)["credential_digest"] == stage["credential_digest"] {
+		t.Fatal("rotation hidden")
+	}
+	saved, _ := bridgeRead(filepath.Join(dir, remote))
+	if saved["refresh_token"] != "synthetic-rotated" {
+		t.Fatal("rotation overwritten")
+	}
+}
+func TestBridgeOAuthCASPreservesSettingsAndRejectsRefresh(t *testing.T) {
+	h, r, _, dir := bridgeFixture(t)
+	existing := map[string]any{"type": "codex", "email": "fixture@example.invalid", "refresh_token": "old", "label": "keep"}
+	if err := bridgeWrite(filepath.Join(dir, "existing.json"), existing); err != nil {
+		t.Fatal(err)
+	}
+	stage := bridgeStage(t, r)
+	existing["label"] = "new setting"
+	if err := bridgeWrite(filepath.Join(dir, "existing.json"), existing); err != nil {
+		t.Fatal(err)
+	}
+	bridgeRequest(t, r, "POST", bridgeTestPath+"/commit", "{}", 200)
+	saved, _ := bridgeRead(filepath.Join(dir, "existing.json"))
+	if saved["label"] != "new setting" || stage["remote_id"] != "existing.json" {
+		t.Fatal(saved)
+	}
+	s := bridgeSession{bridgeBinding: bridgeBinding{Identity: "fixture@example.invalid", RemoteID: "existing.json", Route: bridgeRoute{Type: "direct"}}, SessionID: "second-session-0001", State: "staged", Baseline: bridgeFingerprint(saved), Token: &codex.CodexTokenStorage{Email: "fixture@example.invalid", RefreshToken: "replacement"}}
+	saved["refresh_token"] = "newer"
+	if err := bridgeWrite(filepath.Join(dir, "existing.json"), saved); err != nil {
+		t.Fatal(err)
+	}
+	if err := h.bridgeCommit(dir, filepath.Join(dir, ".bridge-oauth", "second.session"), &s); err == nil {
+		t.Fatal("refresh overwritten")
+	}
+}
+func TestBridgeOAuthUncertainExchangeCancellationAndExpiry(t *testing.T) {
+	_, r, f, dir := bridgeFixture(t)
+	bridgeRequest(t, r, "PUT", bridgeTestPath, bridgeTestStart, 200)
+	path := filepath.Join(dir, ".bridge-oauth", "synthetic-session-0001.session")
+	raw, _ := os.ReadFile(path)
+	var s bridgeSession
+	_ = json.Unmarshal(raw, &s)
+	s.State = "exchanging"
+	if err := bridgeWrite(path, &s); err != nil {
+		t.Fatal(err)
+	}
+	got := bridgeRequest(t, r, "GET", bridgeTestPath, "", 200)
+	if got["state"] != "exchange_uncertain" || f.calls != 0 {
+		t.Fatal(got)
+	}
+	bridgeRequest(t, r, "POST", bridgeTestPath+"/callback", `{}`, 409)
+	cancelled := bridgeRequest(t, r, "DELETE", bridgeTestPath, "", 200)
+	if cancelled["state"] != "cancelled" {
+		t.Fatal(cancelled)
+	}
+	s.State = "pending"
+	s.ExpiresAt = time.Now().Add(-time.Minute)
+	s.Token = &codex.CodexTokenStorage{RefreshToken: "synthetic-expiring-secret"}
+	if err := bridgeWrite(path, &s); err != nil {
+		t.Fatal(err)
+	}
+	expired := bridgeRequest(t, r, "GET", bridgeTestPath, "", 200)
+	if expired["state"] != "expired" {
+		t.Fatal(expired)
+	}
+	raw, _ = os.ReadFile(path)
+	if strings.Contains(string(raw), "synthetic-expiring-secret") {
+		t.Fatal("expired secret retained")
+	}
+}
+func TestBridgeCallbackStrictValidation(t *testing.T) {
+	for _, raw := range []string{"http://127.0.0.1:1455/auth/callback?state=s&code=c", "http://localhost:1455/auth/callback?state=s&state=s&code=c", "http://localhost:1455/auth/callback?state=s&code=c&code=c", "http://localhost:1455/auth/callback?state=wrong&code=c", "http://localhost:1455/auth/callback?state=s&code=c#error", "http://localhost:1455/auth/callback?state=s&code=c&error=denied"} {
+		if _, err := bridgeCallbackCode(raw, "s"); err == nil {
+			t.Errorf("accepted %s", raw)
+		}
+	}
+	if code, err := bridgeCallbackCode("http://localhost:1455/auth/callback?state=s&code=c", "s"); err != nil || code != "c" {
+		t.Fatal(code, err)
+	}
+}
+func TestBridgeOAuthBindingAndAmbiguousIdentity(t *testing.T) {
+	_, r, _, dir := bridgeFixture(t)
+	bridgeRequest(t, r, "PUT", bridgeTestPath, `{"identity":"fixture@example.invalid","route":{"type":"proxy","url":"ftp://invalid"}}`, 400)
+	for _, name := range []string{"a.json", "b.json"} {
+		if err := bridgeWrite(filepath.Join(dir, name), map[string]any{"type": "codex", "email": "fixture@example.invalid"}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	bridgeRequest(t, r, "PUT", bridgeTestPath, bridgeTestStart, 409)
+}
