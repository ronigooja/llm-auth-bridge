diff --git a/internal/accounts/bridge.go b/internal/accounts/bridge.go
new file mode 100644
index 0000000..562f05f
--- /dev/null
+++ b/internal/accounts/bridge.go
@@ -0,0 +1,280 @@
+package accounts
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net/url"
+	"strings"
+	"unicode"
+)
+
+// BridgeCredential is the complete web credential actually used by the gateway.
+type BridgeCredential struct {
+	AccessToken string `json:"access_token"`
+	DeviceID    string `json:"device_id,omitempty"`
+}
+type BridgeRoute struct {
+	Type string `json:"type"`
+	URL  string `json:"url,omitempty"`
+}
+type BridgePayload struct {
+	Identity       string           `json:"identity"`
+	CredentialType string           `json:"credential_type"`
+	Credential     BridgeCredential `json:"credential"`
+	Route          BridgeRoute      `json:"route"`
+	ExpiresAt      json.RawMessage  `json:"expires_at"`
+}
+type BridgeView struct {
+	Identity         string      `json:"identity"`
+	CredentialType   string      `json:"credential_type"`
+	Route            BridgeRoute `json:"route"`
+	CredentialDigest string      `json:"credential_digest"`
+}
+
+// CanonicalJSON matches Python sorted-key compact JSON for the bridge's string
+// credentials. Disable HTML escapes and preserve literal Unicode separators.
+func CanonicalJSON(value any) ([]byte, error) {
+	raw, err := json.Marshal(value)
+	if err != nil {
+		return nil, err
+	}
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	dec.UseNumber()
+	var object any
+	if err = dec.Decode(&object); err != nil {
+		return nil, err
+	}
+	var out bytes.Buffer
+	enc := json.NewEncoder(&out)
+	enc.SetEscapeHTML(false)
+	if err = enc.Encode(object); err != nil {
+		return nil, err
+	}
+	result := bytes.TrimSuffix(out.Bytes(), []byte("\n"))
+	var exact bytes.Buffer
+	for i := 0; i < len(result); i++ {
+		if result[i] == '\\' && i+1 < len(result) {
+			if i+6 <= len(result) && (string(result[i:i+6]) == `\u2028` || string(result[i:i+6]) == `\u2029`) {
+				if result[i+5] == '8' {
+					exact.WriteRune('\u2028')
+				} else {
+					exact.WriteRune('\u2029')
+				}
+				i += 5
+				continue
+			}
+			exact.WriteByte(result[i])
+			i++
+			exact.WriteByte(result[i])
+			continue
+		}
+		exact.WriteByte(result[i])
+	}
+	return exact.Bytes(), nil
+}
+func BridgeDigest(value any) (string, error) {
+	raw, err := CanonicalJSON(value)
+	if err != nil {
+		return "", err
+	}
+	sum := sha256.Sum256(raw)
+	return hex.EncodeToString(sum[:]), nil
+}
+func ValidBridgeID(id string) bool {
+	if id == "" || len(id) > 200 || strings.HasPrefix(id, ".") || strings.Contains(id, "..") {
+		return false
+	}
+	for _, c := range id {
+		if !strings.ContainsRune("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.@+", c) {
+			return false
+		}
+	}
+	return true
+}
+func (b BridgePayload) Validate() error {
+	invalid := &Error{Message: "invalid bridge account payload"}
+	if strings.TrimSpace(b.Identity) == "" || b.Identity != strings.TrimSpace(b.Identity) || b.CredentialType != "chatgpt_web" || b.Credential.AccessToken == "" || strings.TrimSpace(b.Credential.AccessToken) == "" {
+		return invalid
+	}
+	if b.Credential.DeviceID != "" && strings.TrimSpace(b.Credential.DeviceID) == "" {
+		return invalid
+	}
+	for _, text := range []string{b.Identity, b.Credential.AccessToken, b.Credential.DeviceID} {
+		if strings.IndexFunc(text, unicode.IsControl) >= 0 {
+			return invalid
+		}
+	}
+	if len(b.ExpiresAt) > 0 && string(b.ExpiresAt) != "null" {
+		var expiry float64
+		if json.Unmarshal(b.ExpiresAt, &expiry) != nil {
+			return invalid
+		}
+	}
+	switch b.Route.Type {
+	case "direct":
+		if b.Route.URL != "" {
+			return invalid
+		}
+	case "proxy":
+		u, err := url.Parse(b.Route.URL)
+		if err != nil || u.Hostname() == "" || u.Opaque != "" || (u.Path != "" && u.Path != "/") || u.RawQuery != "" || u.Fragment != "" || strings.IndexFunc(b.Route.URL, unicode.IsSpace) >= 0 {
+			return invalid
+		}
+		switch u.Scheme {
+		case "http", "https", "socks5", "socks5h":
+		default:
+			return invalid
+		}
+		if port := u.Port(); port != "" {
+			var n int
+			for _, c := range port {
+				if c < '0' || c > '9' {
+					return invalid
+				}
+				n = n*10 + int(c-'0')
+				if n > 65535 {
+					return invalid
+				}
+			}
+			if n == 0 {
+				return invalid
+			}
+		}
+	default:
+		return invalid
+	}
+	return nil
+}
+
+// BridgeGet computes readback from the current native row, never a request digest.
+func (p *Pool) BridgeGet(remoteID string) (BridgeView, error) {
+	p.db.Lock()
+	defer p.db.Unlock()
+	return p.bridgeGetUnlocked(remoteID)
+}
+func (p *Pool) bridgeGetUnlocked(remoteID string) (BridgeView, error) {
+	var id int64
+	if err := p.db.Conn().QueryRow(`SELECT account_id FROM bridge_accounts WHERE remote_id=?`, remoteID).Scan(&id); err != nil {
+		if errors.Is(err, sql.ErrNoRows) {
+			return BridgeView{}, ErrNotFound
+		}
+		return BridgeView{}, err
+	}
+	account, err := p.getUnlocked(id)
+	if err != nil {
+		return BridgeView{}, err
+	}
+	route := BridgeRoute{Type: "proxy", URL: account.Proxy}
+	if account.Proxy == "direct" {
+		route = BridgeRoute{Type: "direct"}
+	} else if account.Proxy == "" {
+		return BridgeView{}, ErrConflict
+	}
+	digest, err := BridgeDigest(BridgeCredential{AccessToken: account.AccessToken, DeviceID: account.DeviceID})
+	if err != nil {
+		return BridgeView{}, err
+	}
+	return BridgeView{Identity: account.Email, CredentialType: "chatgpt_web", Route: route, CredentialDigest: digest}, nil
+}
+
+// BridgePut atomically binds one caller-owned stable ID to a native account.
+// Existing unrelated accounts are never adopted, even if their token matches.
+func (p *Pool) BridgePut(remoteID, key, payloadDigest string, b BridgePayload) (BridgeView, error) {
+	if !ValidBridgeID(remoteID) || key == "" || len(key) > 512 {
+		return BridgeView{}, &Error{Message: "invalid bridge account request"}
+	}
+	if err := b.Validate(); err != nil {
+		return BridgeView{}, err
+	}
+	stored, hash, err := p.sealExactToken(b.Credential.AccessToken)
+	if err != nil {
+		return BridgeView{}, err
+	}
+	proxy := b.Route.URL
+	if b.Route.Type == "direct" {
+		proxy = "direct"
+	}
+	sealedProxy, err := p.sealOptional(proxy)
+	if err != nil {
+		return BridgeView{}, err
+	}
+	device, err := p.sealOptional(b.Credential.DeviceID)
+	if err != nil {
+		return BridgeView{}, err
+	}
+	p.db.Lock()
+	defer p.db.Unlock()
+	tx, err := p.db.Conn().Begin()
+	if err != nil {
+		return BridgeView{}, err
+	}
+	defer tx.Rollback()
+	var oldID, oldDigest string
+	err = tx.QueryRow(`SELECT remote_id,payload_digest FROM bridge_idempotency WHERE key=?`, key).Scan(&oldID, &oldDigest)
+	if err == nil && (oldID != remoteID || oldDigest != payloadDigest) {
+		return BridgeView{}, ErrConflict
+	}
+	if err != nil && !errors.Is(err, sql.ErrNoRows) {
+		return BridgeView{}, err
+	}
+	replay := err == nil
+	var id int64
+	var identity, nativeIdentity string
+	err = tx.QueryRow(`SELECT a.id,b.identity,a.email FROM bridge_accounts b JOIN accounts a ON a.id=b.account_id WHERE b.remote_id=?`, remoteID).Scan(&id, &identity, &nativeIdentity)
+	exists := err == nil
+	if err != nil && !errors.Is(err, sql.ErrNoRows) {
+		return BridgeView{}, err
+	}
+	if exists && (!strings.EqualFold(identity, b.Identity) || !strings.EqualFold(nativeIdentity, b.Identity)) {
+		return BridgeView{}, ErrConflict
+	}
+	if replay {
+		// Never replay an old write over newer native credentials or routing.
+		if !exists {
+			return BridgeView{}, ErrConflict
+		}
+		if err = tx.Commit(); err != nil {
+			return BridgeView{}, err
+		}
+		return p.bridgeGetUnlocked(remoteID)
+	}
+	var duplicate int
+	if err = tx.QueryRow(`SELECT COUNT(*) FROM accounts WHERE token_hash=? AND id<>?`, hash, id).Scan(&duplicate); err != nil {
+		return BridgeView{}, err
+	}
+	if duplicate > 0 {
+		return BridgeView{}, ErrConflict
+	}
+	if exists {
+		_, err = tx.Exec(`UPDATE accounts SET email=?,access_token=?,token_hash=?,proxy=?,updated_at=CURRENT_TIMESTAMP WHERE id=?`, b.Identity, stored, hash, sealedProxy, id)
+	} else {
+		var result sql.Result
+		result, err = tx.Exec(`INSERT INTO accounts(email,access_token,token_hash,proxy) VALUES(?,?,?,?)`, b.Identity, stored, hash, sealedProxy)
+		if err == nil {
+			id, err = result.LastInsertId()
+		}
+	}
+	if err != nil {
+		return BridgeView{}, err
+	}
+	expiry := string(b.ExpiresAt)
+	if expiry == "" {
+		expiry = "null"
+	}
+	_, err = tx.Exec(`INSERT INTO bridge_accounts(remote_id,identity,account_id,device_id,expires_at) VALUES(?,?,?,?,?) ON CONFLICT(remote_id) DO UPDATE SET device_id=excluded.device_id,expires_at=excluded.expires_at`, remoteID, b.Identity, id, device, expiry)
+	if err != nil {
+		return BridgeView{}, err
+	}
+	_, err = tx.Exec(`INSERT INTO bridge_idempotency(key,remote_id,payload_digest) VALUES(?,?,?)`, key, remoteID, payloadDigest)
+	if err != nil {
+		return BridgeView{}, err
+	}
+	if err = tx.Commit(); err != nil {
+		return BridgeView{}, err
+	}
+	return p.bridgeGetUnlocked(remoteID)
+}
diff --git a/internal/accounts/bridge_test.go b/internal/accounts/bridge_test.go
new file mode 100644
index 0000000..b94f773
--- /dev/null
+++ b/internal/accounts/bridge_test.go
@@ -0,0 +1,199 @@
+package accounts
+
+import (
+	"errors"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/dyhhhhhh/chatgpt-web-voice/internal/secretbox"
+	"github.com/dyhhhhhh/chatgpt-web-voice/internal/store"
+)
+
+func bridgePool(t *testing.T, path string) *Pool {
+	t.Helper()
+	db, err := store.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.Close() })
+	box, err := secretbox.New([]byte("01234567890123456789012345678901"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return NewPoolFromDB(db).WithBox(box)
+}
+func bridgeFixture() BridgePayload {
+	return BridgePayload{Identity: "synthetic@example.test", CredentialType: "chatgpt_web", Credential: BridgeCredential{AccessToken: "synthetic-token<&>测试\u2028\u2029", DeviceID: "测试<&>\u2028\u2029"}, Route: BridgeRoute{Type: "proxy", URL: "socks5h://user:secret@127.0.0.1:9876"}}
+}
+func TestBridgeCanonicalCredentialDigest(t *testing.T) {
+	digest, err := BridgeDigest(BridgeCredential{AccessToken: "synthetic", DeviceID: "测试<&>\u2028\u2029"})
+	if err != nil || digest != "5fcc9d4ab814aedce4447a6dd1243d8f67353cf8270f4d23eeaef6aa6286502d" {
+		t.Fatalf("digest=%s err=%v", digest, err)
+	}
+	raw, err := CanonicalJSON(map[string]string{"device_id": `literal\u2028`})
+	if err != nil || string(raw) != `{"device_id":"literal\\u2028"}` {
+		t.Fatalf("literal separator changed: %q %v", raw, err)
+	}
+}
+func TestBridgePersistenceConflictAndNativeMutation(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "synthetic.db")
+	p := bridgePool(t, path)
+	b := bridgeFixture()
+	v, err := p.BridgePut("bridge-synthetic", "synthetic-key", "digest-one", b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if v.Route != b.Route {
+		t.Fatalf("route=%+v", v.Route)
+	}
+	list, err := p.List()
+	if err != nil || len(list) != 1 || list[0].DeviceID != b.Credential.DeviceID || list[0].AccessToken != b.Credential.AccessToken {
+		t.Fatalf("list=%+v err=%v", list, err)
+	}
+	var token, proxy, device string
+	if err := p.db.Conn().QueryRow(`SELECT access_token,proxy,device_id FROM accounts a JOIN bridge_accounts b ON a.id=b.account_id`).Scan(&token, &proxy, &device); err != nil {
+		t.Fatal(err)
+	}
+	for _, v := range []string{token, proxy, device} {
+		if !secretbox.IsSealed(v) {
+			t.Fatal("plaintext secret persisted")
+		}
+	}
+	p2 := bridgePool(t, path)
+	read, err := p2.BridgeGet("bridge-synthetic")
+	if err != nil || read != v {
+		t.Fatalf("restart read=%+v err=%v", read, err)
+	}
+	b.Identity = "different@example.test"
+	if _, err = p.BridgePut("bridge-synthetic", "other", "other", b); !errors.Is(err, ErrConflict) {
+		t.Fatalf("identity conflict=%v", err)
+	}
+	b = bridgeFixture()
+	if _, err = p.BridgePut("bridge-other", "other", "other", b); !errors.Is(err, ErrConflict) {
+		t.Fatalf("token conflict=%v", err)
+	}
+	if _, err = p.BridgePut("bridge-synthetic", "synthetic-key", "different", b); !errors.Is(err, ErrConflict) {
+		t.Fatalf("idempotency conflict=%v", err)
+	}
+	replacement := "rotated-synthetic-token"
+	direct := "direct"
+	if _, err = p.Update(list[0].ID, AccountUpdate{Email: b.Identity, AccessToken: &replacement, Proxy: &direct}); err != nil {
+		t.Fatal(err)
+	}
+	replay, err := p.BridgePut("bridge-synthetic", "synthetic-key", "digest-one", b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if replay.CredentialDigest == v.CredentialDigest || replay.Route.Type != "direct" {
+		t.Fatal("replay overwrote newer native state")
+	}
+	current, _ := p.Get(list[0].ID)
+	if current.AccessToken != replacement {
+		t.Fatal("rotated token overwritten")
+	}
+	if _, err = p.BridgeGet("absent"); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("missing=%v", err)
+	}
+}
+func TestBridgePreservesUnrelatedNativeAccounts(t *testing.T) {
+	p := bridgePool(t, filepath.Join(t.TempDir(), "synthetic.db"))
+	b := bridgeFixture()
+	b.Credential.AccessToken = "synthetic-shared-native-token"
+	a, err := p.Create(Account{Email: "native@example.test", AccessToken: b.Credential.AccessToken})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = p.BridgePut("bridge-new", "key", "digest", b); !errors.Is(err, ErrConflict) {
+		t.Fatalf("adopted unrelated account: %v", err)
+	}
+	got, _ := p.Get(a.ID)
+	if got.Email != a.Email || got.Proxy != "" {
+		t.Fatal("native account changed")
+	}
+	for _, route := range []BridgeRoute{{Type: ""}, {Type: "proxy", URL: "http://secret@host:99999"}, {Type: "direct", URL: "http://proxy"}} {
+		b.Route = route
+		if b.Validate() == nil {
+			t.Fatalf("accepted invalid route %+v", route)
+		}
+	}
+	if strings.Contains(got.Proxy, "secret") {
+		t.Fatal("unexpected proxy")
+	}
+}
+
+func TestBridgeTransactionRollbackAndDeletedMappingReplay(t *testing.T) {
+	p := bridgePool(t, filepath.Join(t.TempDir(), "synthetic.db"))
+	b := bridgeFixture()
+	if _, err := p.db.Conn().Exec(`CREATE TRIGGER synthetic_bridge_failure BEFORE INSERT ON bridge_accounts BEGIN SELECT RAISE(ABORT,'synthetic'); END`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := p.BridgePut("bridge-rollback", "key", "digest", b); err == nil {
+		t.Fatal("injected failure ignored")
+	}
+	list, err := p.List()
+	if err != nil || len(list) != 0 {
+		t.Fatal("partial native write survived rollback")
+	}
+	if _, err = p.db.Conn().Exec(`DROP TRIGGER synthetic_bridge_failure`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = p.BridgePut("bridge-rollback", "key", "digest", b); err != nil {
+		t.Fatal(err)
+	}
+	list, _ = p.List()
+	if err = p.Delete(list[0].ID); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = p.BridgePut("bridge-rollback", "key", "digest", b); !errors.Is(err, ErrConflict) {
+		t.Fatalf("deleted key replay recreated account: %v", err)
+	}
+	list, _ = p.List()
+	if len(list) != 0 {
+		t.Fatal("deleted account recreated")
+	}
+}
+func TestBridgeMigratesLegacyPlaintextProxy(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "synthetic.db")
+	p := bridgePool(t, path)
+	_, err := p.db.Conn().Exec(`INSERT INTO accounts(email,access_token,proxy) VALUES(?,?,?)`, "legacy@example.test", "synthetic-legacy-token", "http://user:synthetic-secret@127.0.0.1:9876")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = p.SealStoredTokens(); err != nil {
+		t.Fatal(err)
+	}
+	var stored string
+	if err = p.db.Conn().QueryRow(`SELECT proxy FROM accounts`).Scan(&stored); err != nil || !secretbox.IsSealed(stored) {
+		t.Fatal("legacy proxy was not sealed")
+	}
+	p2 := bridgePool(t, path)
+	list, err := p2.List()
+	if err != nil || len(list) != 1 || list[0].Proxy != "http://user:synthetic-secret@127.0.0.1:9876" {
+		t.Fatalf("legacy proxy changed after restart: %+v %v", list, err)
+	}
+	if count, err := p2.SealStoredTokens(); err != nil || count != 0 {
+		t.Fatalf("non-idempotent migration: %d %v", count, err)
+	}
+}
+
+func TestBridgeMappingIdentityCannotBeReassignedByNativeEdit(t *testing.T) {
+	p := bridgePool(t, filepath.Join(t.TempDir(), "synthetic.db"))
+	b := bridgeFixture()
+	if _, err := p.BridgePut("bridge-immutable", "key", "digest", b); err != nil {
+		t.Fatal(err)
+	}
+	list, _ := p.List()
+	changed := "other@example.test"
+	if _, err := p.Update(list[0].ID, AccountUpdate{Email: changed}); err != nil {
+		t.Fatal(err)
+	}
+	read, err := p.BridgeGet("bridge-immutable")
+	if err != nil || read.Identity != changed {
+		t.Fatal("readback must reflect native identity edit")
+	}
+	b.Identity = changed
+	if _, err := p.BridgePut("bridge-immutable", "new-key", "new-digest", b); !errors.Is(err, ErrConflict) {
+		t.Fatalf("mapping reassigned: %v", err)
+	}
